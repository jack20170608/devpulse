<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal configuration for the spike: console only, quiet by default, with the
  product's own loggers at INFO. File rotation and per-command levels are
  decided after the native image proves it can run logback at all.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.github.devpulse" level="INFO"/>
    <logger name="io.muserver" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.jdbi" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
