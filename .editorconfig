# EditorConfig is awesome: http://EditorConfig.org
# Uses editorconfig to maintain consistent coding styles

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 160
trim_trailing_whitespace = true

[*.{tf,tfvars}]
indent_size = 4
indent_style = space

[*.conf]
indent_size = 2

[*.{xml,html,xhtml}]
indent_size = 4
max_line_length = 160

[*.java]
indent_size = 4
max_line_length = 100

# Markdown / reStructuredText keep trailing whitespace: two spaces mean a hard
# line break. Case variants are listed explicitly because EditorConfig pattern
# matching is case-sensitive (readme.MD is tracked in this repo).
[*.{md,MD,rst}]
max_line_length = 160
trim_trailing_whitespace = false

# Tab indentation (no size specified)
[Makefile]
tab_width = 2
indent_style = tab

[COMMIT_EDITMSG]
max_line_length = 160

# Git plumbing files align attribute columns with spaces, never tabs
[{.gitattributes,.gitignore,.gitmodules}]
indent_size = 4
indent_style = space

# Shell scripts, including the extensionless launchers under
# devpulse-dist/src/bin (jira, pulse)
[*.{sh,bash}]
indent_size = tab
indent_style = tab

[devpulse-dist/src/bin/*]
indent_size = tab
indent_style = tab

[*.bats]
indent_size = tab
indent_style = tab
