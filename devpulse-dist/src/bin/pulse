#!/usr/bin/env bash
# devpulse-managed-wrapper: pulse
set -euo pipefail

# 1. 解析 Java 可执行文件路径（优先使用 JAVA_HOME）
if [[ -n "${JAVA_HOME:-}" ]]; then
    java_cmd="$JAVA_HOME/bin/java"
    if [[ ! -x "$java_cmd" ]]; then
        echo "pulse: JAVA_HOME is set to '$JAVA_HOME', but '$java_cmd' is not executable" >&2
        exit 1
    fi
else
    java_cmd="$(command -v java || true)"
    if [[ -z "$java_cmd" ]]; then
        echo "pulse: Java not found. Please install JDK 21+ or set JAVA_HOME" >&2
        exit 1
    fi
fi

# 2. 检查 Java 版本（最低要求 JDK 21）
java_version_output=$("$java_cmd" -version 2>&1 | head -n 1)
if [[ "$java_version_output" =~ \"([0-9]+) ]]; then
    major_version="${BASH_REMATCH[1]}"
    if (( major_version < 21 )); then
        echo "pulse: JDK 21 or higher is required (found version $major_version via $java_cmd)" >&2
        exit 1
    fi
else
    echo "pulse: failed to determine Java version from '$java_cmd'" >&2
    exit 1
fi

# 3. 定位并启动目标 JAR 包
bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
prefix="$(cd -- "$bin_dir/.." && pwd -P)"

if [[ -f "$prefix/devpulse-pulse.jar" ]]; then
    exec "$java_cmd" -jar "$prefix/devpulse-pulse.jar" "$@"
fi

tool_home="$prefix/lib/devpulse/pulse"
if [[ ! -f "$tool_home/current" ]]; then
    echo "pulse: no installed version found; run the installer first" >&2
    exit 1
fi

IFS= read -r version < "$tool_home/current" || true
version="${version//$'\r'/}" # 兼容 CRLF 换行符，防止跨平台编辑导致校验失败

if [[ ! "$version" =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ || "$version" == *..* ||
      ! -f "$tool_home/$version/devpulse-pulse.jar" ]]; then
    echo "pulse: invalid or missing installation" >&2
    exit 1
fi

exec "$java_cmd" -jar "$tool_home/$version/devpulse-pulse.jar" "$@"
