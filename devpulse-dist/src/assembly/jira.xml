<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>jira</id>
    <formats><format>tar.gz</format></formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>devpulse-jira-${project.version}</baseDirectory>
    <files>
        <file>
            <source>../devpulse-plugins/jira/target/devpulse-jira.jar</source>
            <outputDirectory>/</outputDirectory>
            <destName>devpulse-jira.jar</destName>
        </file>
        <file>
            <source>src/bin/jira</source>
            <outputDirectory>/bin</outputDirectory>
            <destName>jira</destName>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>src/assembly/version.txt</source>
            <outputDirectory>/</outputDirectory>
            <filtered>true</filtered>
        </file>
        <file>
            <source>${project.build.directory}/checksums/jira/devpulse-jira.jar.sha256</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>
</assembly>
