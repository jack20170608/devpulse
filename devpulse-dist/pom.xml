<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.devpulse</groupId>
        <artifactId>devpulse-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../devpulse-dependencies/pom.xml</relativePath>
    </parent>
    <artifactId>devpulse-dist</artifactId>
    <packaging>pom</packaging>
    <name>devpulse release archives</name>

    <dependencies>
        <dependency>
            <groupId>io.github.devpulse</groupId>
            <artifactId>pulse</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.devpulse</groupId>
            <artifactId>jira</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jar-checksums</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/checksums/pulse"/>
                                <mkdir dir="${project.build.directory}/checksums/jira"/>
                                <checksum file="${project.basedir}/../devpulse-plugins/pulse/target/devpulse-pulse.jar"
                                          todir="${project.build.directory}/checksums/pulse"
                                          fileext=".sha256" algorithm="SHA-256" format="MD5SUM"/>
                                <checksum file="${project.basedir}/../devpulse-plugins/jira/target/devpulse-jira.jar"
                                          todir="${project.build.directory}/checksums/jira"
                                          fileext=".sha256" algorithm="SHA-256" format="MD5SUM"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>archive-checksums</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <checksum file="${project.build.directory}/devpulse-pulse-${project.version}.tar.gz"
                                          fileext=".sha256" algorithm="SHA-256" format="MD5SUM"/>
                                <checksum file="${project.build.directory}/devpulse-jira-${project.version}.tar.gz"
                                          fileext=".sha256" algorithm="SHA-256" format="MD5SUM"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pulse-archive</id>
                        <phase>prepare-package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/pulse.xml</descriptor>
                            </descriptors>
                            <finalName>devpulse-pulse-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jira-archive</id>
                        <phase>prepare-package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/jira.xml</descriptor>
                            </descriptors>
                            <finalName>devpulse-jira-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
